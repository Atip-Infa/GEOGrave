{
  "name": "geograve-backend",
  "version": "1.1.0",
  "description": "GEOGrave — map-based road incident reporting with geospatial indexing, SQLite R-Tree spatial search, and a full data pipeline",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atip-Infa/geograve.git"
  },
  "homepage": "https://github.com/Atip-Infa/geograve#readme",
  "bugs": {
    "url": "https://github.com/Atip-Infa/geograve/issues"
  },
  "author": "Atip-Infa",
  "license": "MIT",
  "keywords": [
    "geospatial",
    "sqlite",
    "r-tree",
    "spatial-index",
    "incident-reporting",
    "leaflet",
    "express",
    "data-pipeline",
    "etl"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "jest --runInBand",
    "migrate:json-to-sqlite": "node scripts/migrate-json-to-sqlite.js",
    "db:backup": "node scripts/backup.js",
    "db:seed": "node scripts/seed.js",
    "db:quality-check": "node scripts/data-quality-check.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "server.js",
      "lib/**/*.js",
      "middleware/**/*.js"
    ]
  }
}
