# Copy this file to `.env` and fill in real values before deploying.
# Never commit the real `.env` file.

# Server
PORT=3000
NODE_ENV=production

# Comma-separated list of origins allowed to call the API via CORS.
# Leave empty for same-origin only (recommended default for this app,
# since the frontend is served by this same Express app).
ALLOWED_ORIGINS=

# REQUIRED: long random string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin/staff login used to manage reports (edit/delete, view PII fields).
# If ADMIN_PASSWORD is left blank, a random one-time password is generated
# and printed to the server logs on first boot - fine for local dev, NOT
# acceptable for production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
